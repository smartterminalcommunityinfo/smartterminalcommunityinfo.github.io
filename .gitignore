# Exclude everything by default
*

# Allow HTML files
!*.html

# Keep compliance report local only
compliance_report.html

# Allow this file
!.gitignore

# Allow SEO files at the repo root
!robots.txt
!sitemap.xml
!sitemap/
!sitemap/sitemap.xml

# Allow images (and source PDFs) in the maps folder
!maps/
!maps/*.jpg
!maps/*.jpeg
!maps/*.png
!maps/*.webp
!maps/*.pdf

# Allow PDFs in the docs folder
!docs/
!docs/*.pdf

# Allow the generated Pagefind search index (regenerate with: npx pagefind --site .)
!pagefind/
!pagefind/**

# Allow favicons / site icons at the repo root
!favicon.ico
!favicon-*.png
!apple-touch-icon.png
